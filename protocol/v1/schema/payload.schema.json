{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uexplorer.invalid/protocol/v1/payload.schema.json",
  "title": "UExplorer IPC v1 payloads",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/cancel" }
  ],
  "$defs": {
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "objectHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "context_generation", "index", "serial", "address", "class_fingerprint"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "index": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "serial": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "address": { "type": "string", "pattern": "^0x[0-9A-F]{1,16}$" },
        "class_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      }
    },
    "functionHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "owner", "full_path", "signature_fingerprint"],
      "properties": {
        "function": { "$ref": "#/$defs/objectHandle" },
        "owner": { "$ref": "#/$defs/objectHandle" },
        "full_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^Function fname:[0-9a-f]+:[0-9]+(?:\\.fname:[0-9a-f]+:[0-9]+)+$"
        },
        "signature_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      }
    },
    "emptyCommandData": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "handleIssueData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "snapshotCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "after_index"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "after_index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "snapshotPageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "limit"],
      "properties": {
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/snapshotCursor" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "snapshotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "name", "full_path", "class_path", "package_path", "kind"],
      "properties": {
        "handle": { "$ref": "#/$defs/objectHandle" },
        "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "full_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "class_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "package_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "enum": ["object", "package", "class", "struct", "enum", "function"] }
      }
    },
    "snapshotPageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "context_generation",
        "captured_at_monotonic_us",
        "capture_duration_us",
        "source_object_count",
        "record_count",
        "skipped_slots",
        "items",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "captured_at_monotonic_us": { "type": "integer", "minimum": 1 },
        "capture_duration_us": { "type": "integer", "minimum": 0 },
        "source_object_count": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "record_count": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "skipped_slots": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/snapshotRecord" }
        },
        "has_more": { "type": "boolean" },
        "next_cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/snapshotCursor" }
          ]
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_version", "protocol", "target_pid"],
      "properties": {
        "host_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol": { "$ref": "#/$defs/protocolVersion" },
        "target_pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_version", "protocol", "session_id", "target_pid", "engine_profile", "capabilities", "limits"],
      "properties": {
        "core_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol": { "$ref": "#/$defs/protocolVersion" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target_pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "engine_profile": { "type": ["string", "null"], "maxLength": 128 },
        "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "limits": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "session_id", "timeout_ms", "data"],
      "properties": {
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "data": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["status.inspect", "status.engine", "status.health", "status.reconnect"]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/emptyCommandData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["objects.handle.issue", "functions.handle.issue"]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/handleIssueData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "objects.snapshot.page" }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/snapshotPageData" } } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "message": { "type": "string", "maxLength": 1024 },
        "details": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "request_id", "session_id", "error", "data", "timing"],
      "properties": {
        "ok": { "type": "boolean" },
        "request_id": { "type": "integer", "minimum": 1 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
        "data": {},
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queued_us", "execute_us"],
          "properties": {
            "queued_us": { "type": "integer", "minimum": 0 },
            "execute_us": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "kind", "timestamp_us", "session_id", "dropped_before", "data"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
        "timestamp_us": { "type": "integer", "minimum": 0 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dropped_before": { "type": "integer", "minimum": 0 },
        "data": {}
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "reason"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 256 }
      }
    }
  }
}
