{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uexplorer.invalid/protocol/v1/payload.schema.json",
  "title": "UExplorer IPC v1 payloads",
  "anyOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/welcome" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/shutdown" }
  ],
  "$defs": {
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "objectHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "context_generation", "index", "serial", "address", "class_fingerprint"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "index": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "serial": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "address": { "type": "string", "pattern": "^0x[0-9A-F]{1,16}$" },
        "class_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      }
    },
    "functionHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "owner", "full_path", "signature_fingerprint"],
      "properties": {
        "function": { "$ref": "#/$defs/objectHandle" },
        "owner": { "$ref": "#/$defs/objectHandle" },
        "full_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^Function fname:[0-9a-f]+:[0-9]+(?:\\.fname:[0-9a-f]+:[0-9]+)+$"
        },
        "signature_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      }
    },
    "emptyCommandData": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "handleIssueData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "propertyReadData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object", "type_snapshot_generation", "declaring_type_path",
        "property_name", "array_index"
      ],
      "properties": {
        "object": { "$ref": "#/$defs/objectHandle" },
        "type_snapshot_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "declaring_type_path": { "$ref": "#/$defs/typePath" },
        "property_name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "array_index": { "type": "integer", "minimum": 0, "maximum": 1023 }
      }
    },
    "callArgument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "bool" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["int8", "int16", "int32", "int64"] },
            "value": { "type": "string", "pattern": "^(0|-?[1-9][0-9]*)$", "maxLength": 32 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["uint8", "uint16", "uint32", "uint64"] },
            "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 32 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["float", "double"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "object" },
            "value": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/objectHandle" }] }
          }
        }
      ]
    },
    "callInvokeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "function", "type_snapshot_generation", "function_path", "arguments"],
      "properties": {
        "target": { "$ref": "#/$defs/objectHandle" },
        "function": { "$ref": "#/$defs/functionHandle" },
        "type_snapshot_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "function_path": { "$ref": "#/$defs/typePath" },
        "arguments": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": { "minLength": 1, "maxLength": 1024 },
          "additionalProperties": { "$ref": "#/$defs/callArgument" }
        }
      }
    },
    "snapshotCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "after_index"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "after_index": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "snapshotPageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "limit"],
      "properties": {
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/snapshotCursor" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "typePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "typeQueryCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "after_ordinal", "query_fingerprint"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "after_ordinal": { "type": "integer", "minimum": 0, "maximum": 7999999 },
        "query_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      }
    },
    "worldQueryCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "after_ordinal", "query_fingerprint"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "after_ordinal": { "type": "integer", "minimum": 0, "maximum": 1999999 },
        "query_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
      }
    },
    "worldPageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "limit"],
      "properties": {
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/worldQueryCursor" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "worldActorPageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cursor", "limit", "search", "class_search", "level_path"],
      "properties": {
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/worldQueryCursor" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 },
        "search": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 1024 }
          ]
        },
        "class_search": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 1024 }
          ]
        },
        "level_path": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "maxLength": 4096 }
          ]
        }
      }
    },
    "typePathData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/typePath" }
      }
    },
    "typeMemberPageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "scope", "cursor", "limit"],
      "properties": {
        "path": { "$ref": "#/$defs/typePath" },
        "scope": { "enum": ["direct", "include_inherited"] },
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/typeQueryCursor" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "typePathPageData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "cursor", "limit"],
      "properties": {
        "path": { "$ref": "#/$defs/typePath" },
        "cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/typeQueryCursor" }
          ]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "reflectedTypeKind": {
      "enum": ["class", "struct", "enum"]
    },
    "reflectedMemberState": {
      "enum": ["supported", "unsupported", "unavailable"]
    },
    "propertyKind": {
      "enum": [
        "unknown", "bool", "int8", "int16", "int32", "int64",
        "uint8", "uint16", "uint32", "uint64", "float", "double",
        "name", "string", "text", "object", "weak_object", "soft_object",
        "enum", "struct", "array", "map", "set", "delegate"
      ]
    },
    "nullableTypeText": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 4096 }
      ]
    },
    "typeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "kind", "name", "full_path"],
      "properties": {
        "handle": { "$ref": "#/$defs/objectHandle" },
        "kind": { "$ref": "#/$defs/reflectedTypeKind" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "full_path": { "$ref": "#/$defs/typePath" }
      }
    },
    "typeDefaultObjectMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "handle", "reason_code", "reason"],
      "properties": {
        "state": { "enum": ["not_applicable", "present", "not_constructed", "unavailable"] },
        "handle": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/objectHandle" }
          ]
        },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" }
      }
    },
    "typeEnumMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "underlying_kind", "reason_code", "reason", "value_count"],
      "properties": {
        "state": { "$ref": "#/$defs/reflectedMemberState" },
        "underlying_kind": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/propertyKind" }
          ]
        },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" },
        "value_count": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "typeDetailResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "handle", "kind", "name", "full_path", "package_path",
        "properties_size", "min_alignment", "super", "direct_property_count",
        "direct_function_count", "default_object", "enum"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "handle": { "$ref": "#/$defs/objectHandle" },
        "kind": { "$ref": "#/$defs/reflectedTypeKind" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "full_path": { "$ref": "#/$defs/typePath" },
        "package_path": { "$ref": "#/$defs/typePath" },
        "properties_size": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "min_alignment": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "super": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/typeReference" }
          ]
        },
        "direct_property_count": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "direct_function_count": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "default_object": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/typeDefaultObjectMetadata" }
          ]
        },
        "enum": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/typeEnumMetadata" }
          ]
        }
      }
    },
    "typePropertyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "type_name", "kind", "offset", "size", "array_dim", "flags",
        "state", "reason_code", "reason", "descriptor_available",
        "declaring_type", "inheritance_depth"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "type_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "$ref": "#/$defs/propertyKind" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "array_dim": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "flags": { "type": "string", "pattern": "^0x[0-9A-F]{16}$" },
        "state": { "$ref": "#/$defs/reflectedMemberState" },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" },
        "descriptor_available": { "type": "boolean" },
        "declaring_type": { "$ref": "#/$defs/typeReference" },
        "inheritance_depth": { "type": "integer", "minimum": 0, "maximum": 512 }
      }
    },
    "typeFunctionParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "type_name", "kind", "offset", "size", "array_dim", "flags",
        "state", "reason_code", "reason", "descriptor_available", "direction"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "type_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "$ref": "#/$defs/propertyKind" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "array_dim": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "flags": { "type": "string", "pattern": "^0x[0-9A-F]{16}$" },
        "state": { "$ref": "#/$defs/reflectedMemberState" },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" },
        "descriptor_available": { "type": "boolean" },
        "direction": { "enum": ["input", "output", "inout", "return"] }
      }
    },
    "typeFunctionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle", "name", "full_path", "flags", "parameter_size", "parameter_count",
        "native_address", "implementation", "reason_code", "reason", "parameters",
        "declaring_type", "inheritance_depth"
      ],
      "properties": {
        "handle": { "$ref": "#/$defs/functionHandle" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "full_path": { "$ref": "#/$defs/typePath" },
        "flags": { "type": "string", "pattern": "^0x[0-9A-F]{16}$" },
        "parameter_size": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "parameter_count": { "type": "integer", "minimum": 0, "maximum": 128 },
        "native_address": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^0x[0-9A-F]{1,16}$" }
          ]
        },
        "implementation": { "enum": ["unavailable", "native", "bytecode", "native_and_bytecode"] },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" },
        "parameters": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/typeFunctionParameter" }
        },
        "declaring_type": { "$ref": "#/$defs/typeReference" },
        "inheritance_depth": { "type": "integer", "minimum": 0, "maximum": 512 }
      }
    },
    "typeFunctionDetailResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "handle", "name", "full_path", "flags", "parameter_size", "parameter_count",
        "native_address", "implementation", "reason_code", "reason", "parameters",
        "declaring_type", "inheritance_depth"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "handle": { "$ref": "#/$defs/functionHandle" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "full_path": { "$ref": "#/$defs/typePath" },
        "flags": { "type": "string", "pattern": "^0x[0-9A-F]{16}$" },
        "parameter_size": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "parameter_count": { "type": "integer", "minimum": 0, "maximum": 128 },
        "native_address": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^0x[0-9A-F]{1,16}$" }
          ]
        },
        "implementation": { "enum": ["unavailable", "native", "bytecode", "native_and_bytecode"] },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" },
        "parameters": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/typeFunctionParameter" }
        },
        "declaring_type": { "$ref": "#/$defs/typeReference" },
        "inheritance_depth": { "type": "integer", "minimum": 0, "maximum": 512 }
      }
    },
    "typePropertyPageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "path", "kind", "scope", "items", "total", "matched", "limit",
        "has_more", "next_cursor"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "path": { "$ref": "#/$defs/typePath" },
        "kind": { "enum": ["class", "struct"] },
        "scope": { "enum": ["direct", "include_inherited"] },
        "items": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/typePropertyItem" } },
        "total": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "matched": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 },
        "has_more": { "type": "boolean" },
        "next_cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/typeQueryCursor" }] }
      }
    },
    "typeFunctionPageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "path", "kind", "scope", "items", "total", "matched", "limit",
        "has_more", "next_cursor"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "path": { "$ref": "#/$defs/typePath" },
        "kind": { "const": "class" },
        "scope": { "enum": ["direct", "include_inherited"] },
        "items": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/typeFunctionItem" } },
        "total": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "matched": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 },
        "has_more": { "type": "boolean" },
        "next_cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/typeQueryCursor" }] }
      }
    },
    "typeHierarchyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "kind", "name", "full_path", "inheritance_depth"],
      "properties": {
        "handle": { "$ref": "#/$defs/objectHandle" },
        "kind": { "const": "class" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "full_path": { "$ref": "#/$defs/typePath" },
        "inheritance_depth": { "type": "integer", "minimum": 1, "maximum": 512 }
      }
    },
    "typeHierarchyPageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "path", "parents", "children", "total", "matched", "limit", "has_more", "next_cursor"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "path": { "$ref": "#/$defs/typePath" },
        "parents": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/typeHierarchyReference" } },
        "children": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/typeReference" } },
        "total": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "matched": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 },
        "has_more": { "type": "boolean" },
        "next_cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/typeQueryCursor" }] }
      }
    },
    "classDefaultObjectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "class_path", "state", "handle", "reason_code", "reason"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "class_path": { "$ref": "#/$defs/typePath" },
        "state": { "enum": ["present", "not_constructed", "unavailable"] },
        "handle": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/objectHandle" }] },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" }
      }
    },
    "typeEnumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "value": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18}|-[1-9][0-9]{0,18})$" }
      }
    },
    "typeEnumValuePageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_snapshot_generation", "object_snapshot_generation", "context_generation",
        "path", "state", "underlying_kind", "reason_code", "reason", "items",
        "total", "matched", "limit", "has_more", "next_cursor"
      ],
      "properties": {
        "type_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "object_snapshot_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "path": { "$ref": "#/$defs/typePath" },
        "state": { "$ref": "#/$defs/reflectedMemberState" },
        "underlying_kind": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/propertyKind" }] },
        "reason_code": { "$ref": "#/$defs/nullableTypeText" },
        "reason": { "$ref": "#/$defs/nullableTypeText" },
        "items": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/typeEnumValue" } },
        "total": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "matched": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 128 },
        "has_more": { "type": "boolean" },
        "next_cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/typeQueryCursor" }] }
      }
    },
    "snapshotRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "name", "full_path", "class_path", "package_path", "kind"],
      "properties": {
        "handle": { "$ref": "#/$defs/objectHandle" },
        "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "full_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "class_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "package_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "enum": ["object", "package", "class", "struct", "enum", "function"] }
      }
    },
    "snapshotPageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "context_generation",
        "captured_at_monotonic_us",
        "capture_duration_us",
        "source_object_count",
        "record_count",
        "skipped_slots",
        "items",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "context_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "captured_at_monotonic_us": { "type": "integer", "minimum": 1 },
        "capture_duration_us": { "type": "integer", "minimum": 0 },
        "source_object_count": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "record_count": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "skipped_slots": { "type": "integer", "minimum": 0, "maximum": 8000000 },
        "items": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/snapshotRecord" }
        },
        "has_more": { "type": "boolean" },
        "next_cursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/snapshotCursor" }
          ]
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_version", "protocol", "target_pid"],
      "properties": {
        "host_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol": { "$ref": "#/$defs/protocolVersion" },
        "target_pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
      }
    },
    "protocolLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_payload_bytes",
        "pending_rpc_per_session",
        "game_thread_tasks",
        "hook_event_ring",
        "subscriber_events",
        "dump_running",
        "max_timeout_ms"
      ],
      "properties": {
        "max_payload_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "pending_rpc_per_session": { "type": "integer", "minimum": 1, "maximum": 256 },
        "game_thread_tasks": { "type": "integer", "minimum": 1, "maximum": 128 },
        "hook_event_ring": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "subscriber_events": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "dump_running": { "type": "integer", "const": 1 },
        "max_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_version", "protocol", "session_id", "target_pid", "engine_profile", "capabilities", "limits"],
      "properties": {
        "core_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol": { "$ref": "#/$defs/protocolVersion" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target_pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "engine_profile": { "type": ["string", "null"], "maxLength": 128 },
        "capabilities": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
          "additionalProperties": { "type": "boolean" }
        },
        "limits": { "$ref": "#/$defs/protocolLimits" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "session_id", "timeout_ms", "data"],
      "properties": {
        "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "data": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["status.inspect", "status.engine", "status.health", "status.reconnect", "world.inspect"]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/emptyCommandData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["objects.handle.issue", "functions.handle.issue"]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/handleIssueData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "objects.snapshot.page" }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/snapshotPageData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "objects.property.read" }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/propertyReadData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "call.invoke" }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/callInvokeData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "world.levels" }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/worldPageData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "world.actors.list" }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/worldActorPageData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "types.classes.get",
                  "types.classes.cdo",
                  "types.functions.get",
                  "types.structs.get",
                  "types.enums.get"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/typePathData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": [
                  "types.classes.fields",
                  "types.classes.functions",
                  "types.structs.fields"
                ]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/typeMemberPageData" } } }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "enum": ["types.classes.hierarchy", "types.enums.values"]
              }
            },
            "required": ["operation"]
          },
          "then": { "properties": { "data": { "$ref": "#/$defs/typePathPageData" } } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "details": { "type": "object" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "request_id", "session_id", "error", "data", "timing"],
      "properties": {
        "ok": { "type": "boolean" },
        "request_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
        "data": {},
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["queued_us", "execute_us"],
          "properties": {
            "queued_us": { "type": "integer", "minimum": 0 },
            "execute_us": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
          "then": { "properties": { "error": { "type": "null" } } }
        },
        {
          "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
          "then": {
            "properties": {
              "error": { "$ref": "#/$defs/error" },
              "data": { "type": "null" }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "kind", "timestamp_us", "session_id", "dropped_before", "data"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
        "timestamp_us": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dropped_before": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "data": {}
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "reason"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "nonce", "sent_at_monotonic_us"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nonce": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sent_at_monotonic_us": { "type": "integer", "minimum": 1 }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "reason"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
